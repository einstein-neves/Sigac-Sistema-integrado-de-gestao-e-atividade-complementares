# Configuracao SMTP do SIGAC
# Copie estes campos para o .env real e preencha com os dados do provedor.
# Nao publique SMTP_USER, SMTP_PASS nem .env real no GitHub.

# Modo padrao sem envio real:
# EMAIL_MODE=mock

# Modo com envio real:
EMAIL_MODE=smtp

# Gmail com senha de app. Para usar, copie estes campos para o .env
# e troque os placeholders pelo e-mail e pela senha de app reais:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<MEU_EMAIL_GMAIL>
SMTP_PASS=<MINHA_SENHA_DE_APP_GMAIL>
SMTP_FROM="SIGAC Atividades <MEU_EMAIL_GMAIL>"
PASSWORD_RESET_PUBLIC_URL=http://localhost:3000
TWO_FACTOR_AUTH_ENABLED=true
TWO_FACTOR_CODE_TTL_MINUTES=10
TWO_FACTOR_MAX_ATTEMPTS=5

# Outlook / Microsoft 365:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=sigac@outlook.com
# SMTP_PASS=senha_ou_senha_de_app
# SMTP_FROM="SIGAC <sigac@outlook.com>"

# Dominio proprio / institucional:
# SMTP_HOST=smtp.seudominio.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@seudominio.com
# SMTP_PASS=senha_do_email
# SMTP_FROM="SIGAC <noreply@seudominio.com>"
