{
  "watch": [
    "server.js",
    "db.js",
    "js",
    "vendor/css",
    "sigac.css",
    "*.html",
    ".env"
  ],
  "ext": "js,json,html,css,env",
  "ignore": [
    "node_modules/**",
    "mobile/**/node_modules/**",
    "exports/**",
    "data/**",
    "*.log"
  ],
  "exec": "node server.js",
  "delay": "300ms",
  "legacyWatch": true
}
